disk_images
*.iso
*.tar
*secret*
!.b2b-secrets.example

# Downloaded hellish release binary (setup/fetch_hellish.sh)
dist/

# ISO build lock (generate/create_custom_iso.sh)
.gen_iso.lock

# Local secrets (GH_PAT and friends): never committed
.env
.env.*

# generate/feature_select.sh: which features you ticked, for which disk.
.b2b-features
.b2b-llm-ack

# Python byte-code from utils/b2b_config.py, and the apt index cache it
# resolves package sizes from (kept outside the repo footprint).
__pycache__/
.cache/

# A separate clone of the agent-config repo, parked here for reference; it
# carries its own .git and 228 MB of assets, and is not part of the build.
claude-deal-with-the-devil/
